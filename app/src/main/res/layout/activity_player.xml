<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:use_controller="false"
        app:keep_content_on_player_reset="true"
        app:resize_mode="fit"
        app:show_buffering="when_playing" />

    <TextView
        android:id="@+id/digits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="28dp"
        android:background="@drawable/bg_label"
        android:paddingStart="18dp"
        android:paddingTop="6dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp"
        android:textSize="34sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/scrim"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="24dp"
        android:paddingEnd="40dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/chName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/player_hint"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
    <!-- Channel list (OK). Left/right: switch between channels and groups. Always groups on the left. -->
    <LinearLayout
        android:id="@+id/chPanel"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="left|top"
        android:layout_margin="24dp"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/panelGroups"
            android:layout_width="270dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_overlay_panel"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="locale"
                android:text="@string/groups" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/panelGroupList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:descendantFocusability="afterDescendants"
                android:layoutDirection="locale"
                android:scrollbars="none" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="440dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_overlay_panel"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/panelTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/plex_medium"
                android:layoutDirection="locale"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/text"
                android:textSize="20sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/panelChannelList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:descendantFocusability="afterDescendants"
                android:layoutDirection="locale"
                android:scrollbars="none" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="locale"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:text="@string/panel_hint"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
