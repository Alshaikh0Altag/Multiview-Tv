<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.45"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_info" />

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="64dp"
        android:paddingEnd="64dp">

        <ImageView
            android:id="@+id/infoPoster"
            android:layout_width="250dp"
            android:layout_height="375dp"
            android:background="@drawable/bg_logo"
            android:elevation="16dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/infoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/plex_medium"
                android:maxLines="2"
                android:textColor="@color/text"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/infoMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/infoRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:drawableStart="@drawable/ic_star"
                android:drawablePadding="6dp"
                android:fontFamily="@font/plex_medium"
                android:gravity="center_vertical"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/infoPlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.35"
                android:maxLines="6"
                android:textColor="@color/text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/infoPeople"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.3"
                android:maxLines="3"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/infoLoading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="14dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPlay"
                    style="@style/TvButton.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_play"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/on_focus"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:text="@string/play" />

                <Button
                    android:id="@+id/btnStartOver"
                    style="@style/TvButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/start_over"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnFav"
                    style="@style/TvButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:drawableStart="@drawable/ic_star"
                    android:drawablePadding="8dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
