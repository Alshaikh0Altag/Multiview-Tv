<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MultiViewTV" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:fontFamily">@font/plex</item>
        <item name="fontFamily">@font/plex</item>
        <item name="alertDialogTheme">@style/TvDialog</item>
        <item name="android:windowFullscreen">true</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>

    <style name="TvButton">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/row_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:focusable">true</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">@font/plex_medium</item>
    </style>

    <style name="TvButton.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_focus</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TvInput">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:padding">14dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Label">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="TvDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:fontFamily">@font/plex</item>
        <item name="fontFamily">@font/plex</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>

    <style name="TvNav">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:textColor">@color/row_text</item>
        <item name="android:drawableTint">@color/row_text</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textSize">17sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:focusable">true</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">@font/plex_medium</item>
    </style>

    <style name="SectionLabel">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
</resources>
