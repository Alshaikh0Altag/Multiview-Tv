<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><corners android:radius="10dp" /><solid android:color="@color/surface2" /><stroke android:width="3dp" android:color="@color/accent" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><corners android:radius="10dp" /><solid android:color="@color/surface2" /></shape>
    </item>
    <item>
        <shape><corners android:radius="10dp" /><solid android:color="@android:color/transparent" /></shape>
    </item>
</selector>
